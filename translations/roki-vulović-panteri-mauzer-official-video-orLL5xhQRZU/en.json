    {
      "id": "428d3903-107a-44a8-ae38-0662d43baae1",
      "text": "Gardisti Srpske zemlje vraćaju",
      "start": 117.5,
      "end": 121.08,
      "translations": {
        "en": "The guardsmen are reclaiming Serbian lands"
      }
    },
    {
      "id": "1c5b6747-8642-4524-b3f1-0f54a27812ef",
      "text": "Dušmani sve to skupo plaćaju",
      "start": 121.08,
      "end": 125.66,
      "translations": {
        "en": "The enemies pay dearly for it all"
      }
    },
    {
      "id": "d3210ffd-08b7-4f83-976b-5f93be8517ea",
      "text": "Gardisti su borci uvek bili fer",
      "start": 125.66,
