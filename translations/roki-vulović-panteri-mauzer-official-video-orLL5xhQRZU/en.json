  "blocks": [
    {
      "id": "c4c5f3ff-dd61-42f7-9fbb-27dfb2d05294",
      "text": "Bilo je junaka",
      "start": 16.59,
      "end": 18.02,
      "translations": {
        "en": "There have been heroes"
      }
    },
    {
      "id": "4c11543e-5049-41ab-9522-886de039536f",
      "text": "Bilo i biće",
      "start": 18.02,
      "end": 20.13,
      "translations": {
        "en": "There have been, and there will be"
      }
    },
    {
      "id": "8e1b1aa3-0479-464d-89e9-c7d71a17206a",
      "text": "Sunce slobode sada nam sviće",
      "start": 20.13,
      "end": 24.28,
      "translations": {
        "en": "The sun of freedom now rises for us"
      }
    },
    {
      "id": "95b915cc-534c-4553-ad8e-ceb6531261f7",
      "text": "Bilo je i onih koji nisu fer",
      "start": 24.28,
      "end": 28.45,
      "translations": {
        "en": "There have also been those who don't play fair"
      }
    },
    {
      "id": "39c703a3-add8-49eb-92fb-eef947111509",
      "text": "Al' jedan je Mauzer",
      "start": 28.45,
      "end": 32.34,
      "translations": {
        "en": "But there is only one Mauzer"
      }
    },
    {
      "id": "23b1148c-4c8e-4490-9f63-6608098ba83e",
      "text": "Panteri, panteri",
      "start": 32.34,
      "end": 34.4,
      "translations": {
        "en": "Panthers, Panthers"
      }
    },
    {
      "id": "b0e7599e-c889-46aa-9244-84089c5b0376",
      "text": "Vi ste hrabri momci",
      "start": 34.4,
      "end": 36.29,
      "translations": {
        "en": "You are brave lads"
      }
    },
    {
      "id": "e01f044b-1951-4431-893f-4a526cc996a4",
      "text": "Najhrabriji naši srpski dobrovoljci",
      "start": 36.29,
      "end": 40.32,
      "translations": {
        "en": "Our bravest Serbian volunteers"
      }
    },
    {
      "id": "2133993c-c3e2-40f7-8540-88ec27500e19",
      "text": "Podvizi vaši to su prave šeme",
      "start": 40.32,
      "end": 44.28,
      "translations": {
        "en": "Your exploits are the real deal"
      }
    },
    {
      "id": "153f04ee-9584-483a-9a9c-17b47c849cd9",
      "text": "Da ste pravi borci pokazalo vrijeme",
      "start": 44.28,
      "end": 50.28,
      "translations": {
        "en": "Time has shown that you are true fighters"
      }
    },
    {
      "id": "ccdeb948-57f5-45e9-996b-218a7938f1a2",
      "text": "",
      "start": 50.28,
      "end": 66.85,
      "translations": {
        "en": ""
      }
    },
    {
      "id": "0d8edb2b-b905-4996-a9c3-9af608520e73",
      "text": "Ima jedan junak Srpskoga roda",
      "start": 66.85,
      "end": 70.72,
      "translations": {
        "en": "There is a hero of Serbian blood"
      }
    },
    {
      "id": "f7e585c4-7b4b-4c6c-b4a9-9bcfc96abb0f",
      "text": "Iznikao pravo iz svog naroda",
      "start": 70.72,
      "end": 74.91,
      "translations": {
        "en": "Who rose straight from his own people"
      }
    },
    {
      "id": "b45c59a4-6454-4fc4-bda1-119c1603b7e8",
      "text": "Ima jedan borac tih i mnogo fer",
      "start": 74.91,
      "end": 78.72,
      "translations": {
        "en": "There is a fighter, quiet and very fair"
      }
    },
    {
      "id": "10fa5916-21b0-41bb-aefd-cd4720ee0720",
      "text": "To je Ljubo Mauzer",
      "start": 78.72,
      "end": 83.09,
      "translations": {
        "en": "That is Ljubo Mauzer"
      }
    },
